# Modelo do secrets.env da VPS — copie pra
#   /var/www/projetos/repo/excellence/prod/secrets.env
#   /var/www/projetos/repo/excellence/staging/secrets.env
# e preencha. Nunca commitar o arquivo real.
# NODE_ENV, API_PORT, TRUST_PROXY e AUTH_COOKIE_SECURE ficam no ecosystem.

# Banco: excellence_prod / excellence_staging
DATABASE_URL=postgresql://excellence:SENHA@localhost:5432/excellence_prod?schema=public

# Redis: DB 1 = prod, DB 2 = staging
REDIS_URL=redis://127.0.0.1:6390/1

# MinIO: bucket excellence-prod / excellence-staging
S3_ENDPOINT=http://127.0.0.1:9100
# Vhost excellence-arquivos do nginx (sem DNS: IP:8202)
S3_PUBLIC_ENDPOINT=http://169.58.37.26:8202
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=excellence-prod
S3_FORCE_PATH_STYLE=true

# Endereço do web: prod http://IP:8200, staging http://IP:8201
API_CORS_ORIGINS=http://169.58.37.26:8200

# Gere um valor diferente por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
