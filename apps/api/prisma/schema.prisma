// Schema do banco. Convenções em docs/adr/0002-orm-prisma.md:
// - toda tabela de negócio tem company_id;
// - datas sempre DateTime @db.Timestamptz(6) (UTC);
// - triggers, funções e índices parciais ficam em SQL nas migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Organização (mínimo para autenticação; ampliado na etapa 1A.1) ─────────────

model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users            User[]
  refreshTokens    RefreshToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  roles            Role[]

  @@map("companies")
}

// ─── Autenticação ────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid(7)) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  // Identificador de login, único em todo o sistema (ADR 0006).
  email        String  @unique @db.Citext
  name         String
  passwordHash String  @map("password_hash")
  isActive     Boolean @default(true) @map("is_active")

  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  // Segredos TOTP cifrados com AES-256-GCM (MFA_ENCRYPTION_KEY), nunca em claro.
  mfaSecret        String?   @map("mfa_secret")
  mfaPendingSecret String?   @map("mfa_pending_secret")
  // Último passo TOTP aceito: impede reutilizar o mesmo código (replay).
  mfaLastUsedStep  BigInt?   @map("mfa_last_used_step")
  mfaEnabledAt     DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id])
  refreshTokens    RefreshToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  userRoles        UserRole[]

  // Alvo das FKs compostas (id, company_id): impede vínculos entre empresas diferentes.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("users")
}

/// Refresh tokens opacos e rotativos. Cada login abre uma família; cada uso consome o token
/// e emite o próximo. Reapresentar um token consumido revoga a família inteira (ADR 0006).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  // SHA-256 do token; o valor em claro só existe no cliente.
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([companyId])
  @@map("refresh_tokens")
}

/// Códigos de recuperação do MFA (uso único), armazenados como hash.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("mfa_recovery_codes")
}

// ─── Controle de acesso (RBAC) — ADR 0007 ───────────────────────────────────────────

/// Catálogo global de permissões atômicas (recurso:ação). Não pertence a uma empresa:
/// é definido em código (@excellence/shared) e sincronizado quando a API inicia.
model Permission {
  key         String   @id
  resource    String
  action      String
  description String
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.Citext
  description String?
  // Perfis padrão da empresa: editáveis, mas não podem ser excluídos.
  isSystem    Boolean  @default(false) @map("is_system")
  // Exige MFA de quem tem o perfil (ADR 0006). Nunca se decide pelo nome do perfil.
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  scopes      RoleScope[]
  userRoles   UserRole[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("roles")
}

model RolePermission {
  companyId     String @map("company_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([companyId])
  @@map("role_permissions")
}

enum ScopeType {
  company
  unit
  department
  own_team
  self

  @@map("scope_type")
}

/// Escopo de dados de um perfil; o acesso é a união dos escopos. unit_id e department_id
/// ganham FK quando as tabelas de unidades e departamentos existirem (etapa 1A.1).
model RoleScope {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  type         ScopeType
  unitId       String?   @map("unit_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid

  role Role @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([roleId])
  @@index([companyId])
  @@map("role_scopes")
}

model UserRole {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  role Role @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}
