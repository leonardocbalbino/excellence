// Schema do banco. Convenções em docs/adr/0002-orm-prisma.md:
// - toda tabela de negócio tem company_id;
// - datas sempre DateTime @db.Timestamptz(6) (UTC);
// - triggers, funções e índices parciais ficam em SQL nas migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Organização (mínimo para autenticação; ampliado na etapa 1A.1) ─────────────

model Company {
  id                    String   @id @default(uuid(7)) @db.Uuid
  // Nome de exibição (fantasia).
  name                  String
  legalName             String?  @map("legal_name")
  // Sem pontuação; aceita o formato alfanumérico (IN RFB 2.229/2024).
  cnpj                  String?  @unique
  // Fuso padrão para exibição; cada unidade pode ter o seu (regra 4).
  timezone              String   @default("America/Sao_Paulo")
  // Perfil atribuído às contas criadas para funcionários (configurado pelo Admin).
  defaultEmployeeRoleId String?  @map("default_employee_role_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // FK simples: FK composta com o próprio id impede o Prisma de gerar o id no create. A
  // mesma empresa é garantida pelo serviço (busca o perfil pelo client isolado).
  defaultEmployeeRole Role? @relation("CompanyDefaultEmployeeRole", fields: [defaultEmployeeRoleId], references: [id], onDelete: Restrict)

  users               User[]
  refreshTokens       RefreshToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  roles               Role[]                       @relation("CompanyRoles")
  auditLogs           AuditLog[]
  files               StoredFile[]
  units               Unit[]
  departments         Department[]
  positions           Position[]
  laborUnions         LaborUnion[]
  employees           Employee[]
  shifts              Shift[]
  workSchedules       WorkSchedule[]
  holidays            Holiday[]
  scheduleAssignments EmployeeScheduleAssignment[]
  clockSettings       ClockSettings?
  nsrCounter          NsrCounter?
  timeEntries         TimeEntry[]
  adjustmentRequests  TimeAdjustmentRequest[]
  idempotencyKeys     IdempotencyKey[]
  medicalCertificates MedicalCertificate[]

  @@map("companies")
}

// ─── Autenticação ────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid(7)) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  // Identificador de login, único em todo o sistema (ADR 0006).
  email        String  @unique @db.Citext
  name         String
  passwordHash String  @map("password_hash")
  isActive     Boolean @default(true) @map("is_active")

  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  // Segredos TOTP cifrados com AES-256-GCM (MFA_ENCRYPTION_KEY), nunca em claro.
  mfaSecret          String?   @map("mfa_secret")
  mfaPendingSecret   String?   @map("mfa_pending_secret")
  // Último passo TOTP aceito: impede reutilizar o mesmo código (replay).
  mfaLastUsedStep    BigInt?   @map("mfa_last_used_step")
  mfaEnabledAt       DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  // Senha temporária (conta criada pelo RH): o acesso fica restrito até a troca.
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id])
  refreshTokens    RefreshToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  userRoles        UserRole[]
  employee         Employee?

  // Alvo das FKs compostas (id, company_id): impede vínculos entre empresas diferentes.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("users")
}

/// Refresh tokens opacos e rotativos. Cada login abre uma família; cada uso consome o token
/// e emite o próximo. Reapresentar um token consumido revoga a família inteira (ADR 0006).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  // SHA-256 do token; o valor em claro só existe no cliente.
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([companyId])
  @@map("refresh_tokens")
}

/// Códigos de recuperação do MFA (uso único), armazenados como hash.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("mfa_recovery_codes")
}

// ─── Controle de acesso (RBAC) — ADR 0007 ───────────────────────────────────────────

/// Catálogo global de permissões atômicas (recurso:ação). Não pertence a uma empresa:
/// é definido em código (@excellence/shared) e sincronizado quando a API inicia.
model Permission {
  key         String   @id
  resource    String
  action      String
  description String
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.Citext
  description String?
  // Perfis padrão da empresa: editáveis, mas não podem ser excluídos.
  isSystem    Boolean  @default(false) @map("is_system")
  // Exige MFA de quem tem o perfil (ADR 0006). Nunca se decide pelo nome do perfil.
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company          @relation("CompanyRoles", fields: [companyId], references: [id])
  permissions RolePermission[]
  scopes      RoleScope[]
  userRoles   UserRole[]
  defaultFor  Company[]        @relation("CompanyDefaultEmployeeRole")

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("roles")
}

model RolePermission {
  companyId     String @map("company_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([companyId])
  @@map("role_permissions")
}

enum ScopeType {
  company
  unit
  department
  own_team
  self

  @@map("scope_type")
}

/// Escopo de dados de um perfil; o acesso é a união dos escopos. unit_id e department_id
/// ganham FK quando as tabelas de unidades e departamentos existirem (etapa 1A.1).
model RoleScope {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  type         ScopeType
  unitId       String?   @map("unit_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid

  role       Role        @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)
  unit       Unit?       @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  department Department? @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([roleId])
  @@index([companyId])
  @@map("role_scopes")
}

model UserRole {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  role Role @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

// ─── Auditoria — ADR 0008 ────────────────────────────────────────────────────────────

/// Append-only: UPDATE, DELETE e TRUNCATE bloqueados por trigger (forbid_mutation).
/// actor_user_id não tem FK de propósito: o registro de auditoria sobrevive a qualquer
/// mudança nos cadastros.
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  // Horário oficial do servidor, em UTC.
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorIp      String?  @map("actor_ip")
  requestId    String?  @map("request_id")
  // Verbo no passado, com o domínio de prefixo: "auth.login_succeeded", "role.updated".
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([companyId, resourceType, resourceId])
  @@index([companyId, actorUserId])
  @@map("audit_logs")
}

// ─── Arquivos — ADR 0008 ─────────────────────────────────────────────────────────────

enum FileStatus {
  pending
  uploaded

  @@map("file_status")
}

model StoredFile {
  id           String     @id @default(uuid(7)) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  // Finalidade (define tipos e tamanho aceitos): ver FILE_PURPOSES em @excellence/shared.
  purpose      String
  // Chave no bucket, gerada pelo servidor; nunca deriva do nome enviado pelo usuário.
  storageKey   String     @unique @map("storage_key")
  originalName String     @map("original_name")
  contentType  String     @map("content_type")
  sizeBytes    Int        @map("size_bytes")
  status       FileStatus @default(pending)
  uploadedBy   String     @map("uploaded_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt  DateTime?  @map("confirmed_at") @db.Timestamptz(6)

  company             Company              @relation(fields: [companyId], references: [id])
  medicalCertificates MedicalCertificate[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("files")
}

// ─── Organização — ADR 0010 ─────────────────────────────────────────────────────────

model Unit {
  id                   String   @id @default(uuid(7)) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  name                 String
  code                 String?  @db.Citext
  cnpj                 String?
  street               String?
  number               String?
  complement           String?
  district             String?
  city                 String?
  state                String?  @db.Char(2)
  postalCode           String?  @map("postal_code")
  latitude             Float?
  longitude            Float?
  // Raio da cerca virtual em metros; null = sem cerca.
  geofenceRadiusMeters Int?     @map("geofence_radius_meters")
  // Fuso da unidade; null = fuso da empresa.
  timezone             String?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  employees   Employee[]
  roleScopes  RoleScope[]
  holidays    Holiday[]
  timeEntries TimeEntry[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("units")
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  code      String?  @db.Citext
  // Unidade a que pertence; null = vale para a empresa toda.
  unitId    String?  @map("unit_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company     @relation(fields: [companyId], references: [id])
  unit       Unit?       @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  employees  Employee[]
  roleScopes RoleScope[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("departments")
}

model Position {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.Citext
  // Classificação Brasileira de Ocupações (6 dígitos).
  cbo       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("positions")
}

model LaborUnion {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.Citext
  cnpj      String?
  // Mês da data-base da categoria (1 a 12).
  baseMonth Int?     @map("base_month") @db.SmallInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("unions")
}

// ─── Pessoas — ADR 0010 ─────────────────────────────────────────────────────────────

model Employee {
  id                 String    @id @default(uuid(7)) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  // Conta de acesso (login) do funcionário, se houver.
  userId             String?   @unique @map("user_id") @db.Uuid
  registrationNumber String    @map("registration_number") @db.Citext
  name               String
  socialName         String?   @map("social_name")
  // Só dígitos.
  cpf                String    @db.Char(11)
  pis                String?   @db.Char(11)
  birthDate          DateTime? @map("birth_date") @db.Date
  email              String?   @db.Citext
  phone              String?
  hireDate           DateTime  @map("hire_date") @db.Date
  terminationDate    DateTime? @map("termination_date") @db.Date
  unitId             String    @map("unit_id") @db.Uuid
  departmentId       String?   @map("department_id") @db.Uuid
  positionId         String?   @map("position_id") @db.Uuid
  unionId            String?   @map("union_id") @db.Uuid
  // Gestor direto: define a "própria equipe" (escopo own_team).
  managerId          String?   @map("manager_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company             Company                      @relation(fields: [companyId], references: [id])
  user                User?                        @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  unit                Unit                         @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  department          Department?                  @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  position            Position?                    @relation(fields: [positionId, companyId], references: [id, companyId], onDelete: Restrict)
  union               LaborUnion?                  @relation(fields: [unionId, companyId], references: [id, companyId], onDelete: Restrict)
  manager             Employee?                    @relation("EmployeeManager", fields: [managerId, companyId], references: [id, companyId], onDelete: Restrict)
  reports             Employee[]                   @relation("EmployeeManager")
  scheduleAssignments EmployeeScheduleAssignment[]
  timeEntries         TimeEntry[]
  adjustmentRequests  TimeAdjustmentRequest[]
  medicalCertificates MedicalCertificate[]

  @@unique([userId, companyId])
  @@unique([companyId, cpf])
  @@unique([companyId, registrationNumber])
  @@unique([id, companyId])
  @@index([companyId, unitId])
  @@index([companyId, departmentId])
  @@index([companyId, managerId])
  @@map("employees")
}

// ─── Jornada — ADR 0011 ─────────────────────────────────────────────────────────────

/// Turno: horário de início e fim em minutos do dia (0 a 1439). Fim menor ou igual ao
/// início = termina no dia seguinte. Limites legais não são validados aqui (pendência P-012).
model Shift {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String   @db.Citext
  code         String?
  startMinute  Int      @map("start_minute") @db.SmallInt
  endMinute    Int      @map("end_minute") @db.SmallInt
  breakMinutes Int      @map("break_minutes") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company           @relation(fields: [companyId], references: [id])
  scheduleDays WorkScheduleDay[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("shifts")
}

enum ScheduleKind {
  cycle
  flexible

  @@map("schedule_kind")
}

enum CycleAnchor {
  monday
  assignment

  @@map("cycle_anchor")
}

model WorkSchedule {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  name          String       @db.Citext
  code          String?
  kind          ScheduleKind
  cycleAnchor   CycleAnchor? @map("cycle_anchor")
  // Carga de referência da escala flexível (minutos por semana).
  weeklyMinutes Int?         @map("weekly_minutes")
  notes         String?
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company                      @relation(fields: [companyId], references: [id])
  days        WorkScheduleDay[]
  assignments EmployeeScheduleAssignment[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("work_schedules")
}

/// Dia do ciclo da escala: um turno ou folga (shift_id nulo).
model WorkScheduleDay {
  companyId  String  @map("company_id") @db.Uuid
  scheduleId String  @map("schedule_id") @db.Uuid
  dayIndex   Int     @map("day_index") @db.SmallInt
  shiftId    String? @map("shift_id") @db.Uuid

  schedule WorkSchedule @relation(fields: [scheduleId, companyId], references: [id, companyId], onDelete: Cascade)
  shift    Shift?       @relation(fields: [shiftId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([scheduleId, dayIndex])
  @@index([companyId])
  @@map("work_schedule_days")
}

enum HolidayScope {
  national
  state
  city
  company
  unit

  @@map("holiday_scope")
}

model Holiday {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  date      DateTime     @db.Date
  name      String
  scope     HolidayScope
  state     String?      @db.Char(2)
  city      String?      @db.Citext
  unitId    String?      @map("unit_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit?   @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, date])
  @@map("holidays")
}

/// Vínculo do funcionário a uma escala, com histórico. Períodos não se sobrepõem
/// (constraint EXCLUDE no banco).
model EmployeeScheduleAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  scheduleId     String    @map("schedule_id") @db.Uuid
  startDate      DateTime  @map("start_date") @db.Date
  // Último dia na escala; null = vigente.
  endDate        DateTime? @map("end_date") @db.Date
  // Dia 1 do ciclo, para escalas ancoradas no funcionário.
  cycleStartDate DateTime  @map("cycle_start_date") @db.Date
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company      @relation(fields: [companyId], references: [id])
  employee Employee     @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  schedule WorkSchedule @relation(fields: [scheduleId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, employeeId, startDate])
  @@index([scheduleId])
  @@map("employee_schedule_assignments")
}

// ─── Ponto — ADR 0012 ───────────────────────────────────────────────────────────────

enum ClockOutsideGeofence {
  allow
  block

  @@map("clock_outside_geofence")
}

/// Parâmetros do ponto por empresa (regras que dependem de decisão: pendências P-008/P-015).
model ClockSettings {
  companyId         String               @id @map("company_id") @db.Uuid
  // Marcação fora da cerca virtual: aceitar e sinalizar, ou recusar.
  outsideGeofence   ClockOutsideGeofence @default(allow) @map("outside_geofence")
  requireLocation   Boolean              @default(false) @map("require_location")
  requireSelfie     Boolean              @default(false) @map("require_selfie")
  // Janela (minutos) após o fim de um turno que vira a meia-noite em que a marcação ainda
  // pertence ao dia de trabalho anterior (atribuição ao dia no espelho).
  overnightGraceMin Int                  @default(240) @map("overnight_grace_minutes") @db.SmallInt
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@map("clock_settings")
}

/// Contador de NSR (número sequencial de registro) por empresa.
model NsrCounter {
  companyId String @id @map("company_id") @db.Uuid
  lastNsr   BigInt @default(0) @map("last_nsr")

  company Company @relation(fields: [companyId], references: [id])

  @@map("nsr_counters")
}

enum TimeEntryKind {
  // Marcação feita pelo funcionário.
  clock
  // Marcação incluída por ajuste aprovado.
  inclusion
  // Desconsideração de uma marcação anterior (que continua gravada).
  disregard

  @@map("time_entry_kind")
}

enum GeofenceStatus {
  inside
  outside
  no_location
  no_fence

  @@map("geofence_status")
}

/// Marcações de ponto. Append-only (trigger): correção é um novo registro que referencia o
/// original. Hash encadeado por funcionário (regra 3). Horário oficial = servidor, UTC.
model TimeEntry {
  id                  String         @id @default(uuid(7)) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  employeeId          String         @map("employee_id") @db.Uuid
  unitId              String         @map("unit_id") @db.Uuid
  nsr                 BigInt
  kind                TimeEntryKind
  // Horário oficial (servidor, UTC). Na inclusão, o horário aprovado no ajuste.
  recordedAt          DateTime       @map("recorded_at") @db.Timestamptz(6)
  // Horário informado pelo dispositivo: só para auditoria.
  deviceRecordedAt    DateTime?      @map("device_recorded_at") @db.Timestamptz(6)
  // Marcação desconsiderada (kind = disregard).
  referencesEntryId   String?        @map("references_entry_id") @db.Uuid
  adjustmentRequestId String?        @map("adjustment_request_id") @db.Uuid
  latitude            Float?
  longitude           Float?
  accuracyMeters      Float?         @map("accuracy_meters")
  distanceMeters      Float?         @map("distance_meters")
  geofenceStatus      GeofenceStatus @map("geofence_status")
  selfieFileId        String?        @map("selfie_file_id") @db.Uuid
  source              String
  ipAddress           String?        @map("ip_address")
  userAgent           String?        @map("user_agent")
  createdBy           String         @map("created_by") @db.Uuid
  previousHash        String?        @map("previous_hash")
  hash                String         @unique
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company     @relation(fields: [companyId], references: [id])
  employee   Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  unit       Unit        @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  references TimeEntry?  @relation("EntryReference", fields: [referencesEntryId, companyId], references: [id, companyId], onDelete: Restrict)
  disregards TimeEntry[] @relation("EntryReference")

  @@unique([companyId, nsr])
  @@unique([id, companyId])
  @@index([companyId, employeeId, recordedAt])
  @@map("time_entries")
}

enum AdjustmentType {
  // Incluir marcação que faltou.
  include
  // Desconsiderar marcação existente.
  disregard

  @@map("adjustment_type")
}

enum AdjustmentStatus {
  pending
  approved
  rejected
  cancelled

  @@map("adjustment_status")
}

/// Solicitação de ajuste de ponto. Aprovada, gera a marcação correspondente em time_entries.
model TimeAdjustmentRequest {
  id            String           @id @default(uuid(7)) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  employeeId    String           @map("employee_id") @db.Uuid
  type          AdjustmentType
  // Inclusão: horário proposto (UTC).
  proposedAt    DateTime?        @map("proposed_at") @db.Timestamptz(6)
  // Desconsideração: marcação alvo.
  targetEntryId String?          @map("target_entry_id") @db.Uuid
  reason        String
  status        AdjustmentStatus @default(pending)
  requestedBy   String           @map("requested_by") @db.Uuid
  decidedBy     String?          @map("decided_by") @db.Uuid
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?          @map("decision_note")
  resultEntryId String?          @map("result_entry_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@map("time_adjustment_requests")
}

/// Respostas guardadas por Idempotency-Key (regra 5): repetir a requisição devolve a mesma
/// resposta, sem repetir o efeito.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  route          String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ─── Atestados — ADR 0013 ───────────────────────────────────────────────────────────

enum MedicalCertificateStatus {
  pending
  accepted
  rejected
  cancelled

  @@map("medical_certificate_status")
}

/// Atestado ou declaração de comparecimento. O CID é dado sensível (regra 7): só sai pela
/// rota própria, com permissão sensível e auditoria da leitura.
model MedicalCertificate {
  id             String                   @id @default(uuid(7)) @db.Uuid
  companyId      String                   @map("company_id") @db.Uuid
  employeeId     String                   @map("employee_id") @db.Uuid
  // Documento digitalizado (finalidade medical_certificate). Um arquivo, um atestado.
  fileId         String                   @unique @map("file_id") @db.Uuid
  startDate      DateTime                 @map("start_date") @db.Date
  endDate        DateTime                 @map("end_date") @db.Date
  // Afastamento parcial (declaração de horas): só em atestado de um dia, minutos do dia.
  startMinute    Int?                     @map("start_minute")
  endMinute      Int?                     @map("end_minute")
  issuerName     String?                  @map("issuer_name")
  // Registro profissional do emissor (ex.: CRM/UF), como escrito no documento.
  issuerRegistry String?                  @map("issuer_registry")
  cid            String?
  notes          String?
  status         MedicalCertificateStatus @default(pending)
  submittedBy    String                   @map("submitted_by") @db.Uuid
  reviewedBy     String?                  @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?                  @map("review_note")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company    @relation(fields: [companyId], references: [id])
  employee Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  file     StoredFile @relation(fields: [fileId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, employeeId, startDate])
  @@map("medical_certificates")
}
