# Postgres
POSTGRES_USER=excellence
POSTGRES_PASSWORD=excellence
POSTGRES_DB=excellence
DATABASE_URL=postgresql://excellence:excellence@localhost:5432/excellence?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatível)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=excellence
S3_SECRET_KEY=excellence-secret
S3_BUCKET=excellence
S3_FORCE_PATH_STYLE=true

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# API
NODE_ENV=development
API_PORT=3000
# Origens liberadas no CORS, separadas por vírgula
API_CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Publica /docs e /openapi.json
OPENAPI_ENABLED=true
