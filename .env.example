# Postgres
POSTGRES_USER=excellence
POSTGRES_PASSWORD=excellence
POSTGRES_DB=excellence
DATABASE_URL=postgresql://excellence:excellence@localhost:5432/excellence?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatível)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=excellence
S3_SECRET_KEY=excellence-secret
S3_BUCKET=excellence
S3_FORCE_PATH_STYLE=true
# Endereço do storage visto pelo navegador (se diferente de S3_ENDPOINT)
# S3_PUBLIC_ENDPOINT=https://arquivos.exemplo.com.br
# Validade das URLs pré-assinadas de upload e download, em segundos
FILE_URL_TTL_SECONDS=300

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# API
NODE_ENV=development
API_PORT=3000
# Origens liberadas no CORS, separadas por vírgula
API_CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Publica /docs e /openapi.json
OPENAPI_ENABLED=true
# "trust proxy" do Express: false, true, nº de saltos ou lista de IPs
TRUST_PROXY=false

# Autenticação — gere valores próprios fora do ambiente local:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcy1sb25nISE=
MFA_ISSUER=Excellence
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_LOCKOUT_MINUTES=15
# Tamanho mínimo de senha (política completa: pendência P-002)
PASSWORD_MIN_LENGTH=10

# Senha dos usuários criados pelo seed (somente desenvolvimento)
SEED_PASSWORD=Excellence@2026
